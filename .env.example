# Environment Configuration for Platinenmachergpt
# Copy this file to .env and update the values

# Path to your RKLLM models directory or a specific model file.
# When set to a directory, the server will search for .rkllm files matching
# the model name from the request (e.g., model="llama3" will look for "llama3.rkllm").
# If set to a specific file, its parent directory will be searched.
# The current working directory is also searched as a fallback.
MODEL_PATH=/path/to/models

# Logging configuration (optional)
# RUST_LOG=platinenmachergpt=info,tower_http=info
